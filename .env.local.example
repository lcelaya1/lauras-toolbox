GROQ_API_KEY=your_key_here

# Cloudflare R2 — https://dash.cloudflare.com → R2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=lauras-toolbox
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# Toolbox sign-in (separate External Google Cloud project, scopes: openid email)
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
# openssl rand -base64 32
AUTH_SECRET=
# Production only: https://lauras-toolbox.vercel.app
APP_URL=
# Optional, comma-separated (defaults to Laura's two accounts)
AUTH_ALLOWED_EMAILS=
